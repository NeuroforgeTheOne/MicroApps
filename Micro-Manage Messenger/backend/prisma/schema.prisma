// Prisma schema for Micro-Manage Messenger
// Models: User, Message, Chat, Group, AuditLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
  chats     Chat[]
  groups    Group[]
  role      String   // 'user' | 'admin'
}

model Message {
  id        String   @id @default(uuid())
  text      String?
  mediaUrl  String?
  type      String   // 'text' | 'image' | 'video' | 'file'
  sender    User     @relation(fields: [senderId], references: [id])
  senderId  String
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    String
  createdAt DateTime @default(now())
  editedAt  DateTime?
  deleted   Boolean  @default(false)
}

model Chat {
  id        String   @id @default(uuid())
  name      String?
  isGroup   Boolean  @default(false)
  messages  Message[]
  users     User[]
  group     Group?
  createdAt DateTime @default(now())
}

model Group {
  id        String   @id @default(uuid())
  name      String
  chats     Chat[]
  users     User[]
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  details   String?
  createdAt DateTime @default(now())
}
